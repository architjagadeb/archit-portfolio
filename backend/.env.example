# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Frontend Origin for CORS (e.g. http://localhost:5173 for local Vite dev, or production domain)
FRONTEND_ORIGIN=http://localhost:5173

# Optional: Path to resume PDF (defaults to backend/data/Archit Jagadeb Resume.pdf)
RESUME_PDF_PATH=data/Archit Jagadeb Resume.pdf

# Optional: Rate limiting settings
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
